# ── قاعدة البيانات ──────────────────────────────────────────────
# سلسلة اتصال MySQL. بدونها ترد كل مسارات /api/news بـ 503 (لا 404).
# ⚠️ يجب أن يعمل خادم MySQL بتوقيت UTC — راجع docs/OPERATIONS.md
NUXT_DATABASE_URL=        # mysql://user:pass@host:port/db

# ── هوية الموقع ─────────────────────────────────────────────────
# الأصل العام المستعمل في canonical وOG وخرائط الموقع وRSS (بلا شرطة مائلة أخيرة).
NUXT_PUBLIC_SITE_URL=https://ajel-now.net

# ── صور OG ──────────────────────────────────────────────────────
# سرّ ثابت لتوقيع روابط صور OG. إلزامي عند النشر متعدّد النسخ،
# وإلا تنكسر الروابط بين النسخ لأن السرّ يُولَّد عشوائياً لكل بناء.
# توليده: npx nuxt-og-image generate-secret
NUXT_OG_IMAGE_SECRET=

# ── موروث من النسخة السابقة (غير مستعمل حالياً) ────────────────
NUXT_APP_ID=
NUXT_APP_SECRET=

# ── خط الأتمتة (RSS → AI → مسوّدة) ──────────────────────────────
MISTRAL_API_KEY=          # مفتاح Mistral — بدونه تتوقف المهمة المجدولة بلا خطأ
ADMIN_TOKEN=              # رمز حماية مسارات /api/admin/* — غيابه يُغلقها لا يفتحها

# عدد المُدخَلات المعالَجة لكل مصدر في كل تشغيل (يحدّ من كلفة الاستدعاءات)
INGEST_MAX_PER_RUN=5

# ⚠️ النشر التلقائي بلا مراجعة بشرية. الافتراضي false عمداً:
# النشر الآلي المكثّف يعرّض الموقع لعقوبات «المحتوى المُوسَّع» من محركات البحث،
# ويعرّض حساب الإعلانات للإيقاف. لا ترفعه إلا بقرار واعٍ.
INGEST_AUTOPUBLISH=false

# ── الفهرسة ─────────────────────────────────────────────────────
# false = noindex. ارفعه بعد استبدال المحتوى التجريبي بمحتوى تحريري حقيقي.
NUXT_SITE_INDEXABLE=false
